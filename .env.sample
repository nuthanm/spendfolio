# Copy this file to `.env` and fill in real values:
#   cp .env.sample .env

# Neon Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session signing secret (16+ characters). Generate one with any of:
#
#   # Node (cross-platform)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
#   # OpenSSL
#   openssl rand -base64 32
#
#   # PowerShell (Windows)
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#   # or cryptographically strong:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#
#   # Git Bash / WSL / macOS / Linux
#   openssl rand -hex 32
#
# Then paste the output below (keep quotes):
AUTH_SECRET="replace-with-generated-secret"

# Optional seed overrides (used by `npm run db:seed`)
# SEED_EMAIL="you@spendfolio.local"
# SEED_PASSWORD="Spendfolio1!"
