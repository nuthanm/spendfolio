generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  incomes      IncomeSource[]
  expenses     Expense[]
  fieldDefs    CustomFieldDef[]
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    @default("full") // pending_2fa | full
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model IncomeSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  recurring Boolean  @default(true)
  cadence   String   @default("Monthly") // Monthly | Weekly | Variable — for recurring
  nextDate  String?
  monthKey  String?  // YYYY-MM — required when recurring = false (one-time)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, monthKey])
}

model Expense {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String
  label        String
  amount       Float
  remarks      String   @default("")
  recurring    Boolean  @default(false)
  renewalDate  String?  // next due / next month date when recurring
  customFields String   @default("{}") // JSON
  monthKey     String   // YYYY-MM
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, monthKey])
  @@index([userId, renewalDate])
  @@index([userId, recurring])
}

model CustomFieldDef {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  type      String   // text | textarea | dropdown | checkbox | date | number
  options   String   @default("[]") // JSON array for dropdown
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}
